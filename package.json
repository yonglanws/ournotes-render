{
  "name": "ournotes-render",
  "version": "0.4.0",
  "description": "Headless pure-API Our Notes style Live2D story video renderer: AI story direction, TTS, deterministic frames and MP4",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./host/main.js",
  "workspaces": [
    "host"
  ],
  "homepage": "https://github.com/empty-sekai/ournotes-player#readme",
  "bugs": {
    "url": "https://github.com/empty-sekai/ournotes-player/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/empty-sekai/ournotes-player.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node host/main.js",
    "check": "node host/tools/check.mjs",
    "tts:check": "node host/tools/tts-check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:host": "node --test \"host/tests/**/*.test.mjs\"",
    "host:fetch-story": "node host/tools/fetch-story.mjs",
    "host:render-story": "node host/tools/render-story.mjs",
    "host:site-story": "node host/tools/site-story.mjs",
    "host:ai-site-story": "node host/tools/ai-site-story.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
